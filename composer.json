{
    "name": "sozodesign/idiorm",
    "type": "library",
    "description": "SOZO fork of Idiorm for PHP 8.4+: a lightweight nearly-zero-configuration object-relational mapper and fluent query builder",
    "keywords": [
        "idiorm",
        "orm",
        "query builder"
    ],
    "homepage": "https://github.com/sozo-design/idiorm",
    "support": {
        "issues": "https://github.com/sozo-design/idiorm/issues",
        "source": "https://github.com/sozo-design/idiorm"
    },
    "authors": [
        {
            "name": "Jamie Matthews",
            "email": "jamie.matthews@gmail.com",
            "homepage": "http://j4mie.org",
            "role": "Developer"
        },
        {
            "name": "Simon Holywell",
            "email": "treffynnon@php.net",
            "homepage": "https://www.simonholywell.com",
            "role": "Maintainer"
        },
        {
            "name": "Durham Hale",
            "email": "me@durhamhale.com",
            "homepage": "http://durhamhale.com",
            "role": "Maintainer"
        },
        {
            "name": "Clive Walkden",
            "homepage": "https://sozodesign.co.uk",
            "role": "Maintainer of the SOZO fork"
        }
    ],
    "license": [
        "BSD-2-Clause",
        "BSD-3-Clause",
        "BSD-4-Clause"
    ],
    "require": {
        "php": ">=8.4",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "ext-pdo_sqlite": "*"
    },
    "replace": {
        "j4mie/idiorm": "self.version"
    },
    "conflict": {
        "clivewalkden/idiorm": "*"
    },
    "autoload": {
        "classmap": [
            "idiorm.php"
        ]
    },
    "scripts": {
        "test": "phpunit"
    }
}
